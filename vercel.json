{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "cd Frontend && npm ci --ignore-scripts",
  "buildCommand": "cd Frontend && npm run build",
  "outputDirectory": "Frontend/dist",
  "framework": null,
  "rewrites": [
    {
      "source": "/((?!assets/|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
